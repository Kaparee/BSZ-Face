<Window x:Class="FaceAuthApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FaceAuthApp"
        mc:Ignorable="d"
        Title="System Autoryzacji - Rozpoznawanie Twarzy" Height="450" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Button x:Name="LoadImageButton" Content="Wczytaj zdjęcie" Grid.Row="0" Height="40" Click="LoadImageButton_Click" FontSize="16"/>
        
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="0,10,0,10">
            <Image x:Name="FaceImage" Stretch="Uniform"/>
        </Border>
        
        <TextBlock x:Name="ResultLabel" Grid.Row="2" Text="Gotowy" FontSize="20" FontWeight="Bold" TextAlignment="Center" Height="40"/>
    </Grid>
</Window>
