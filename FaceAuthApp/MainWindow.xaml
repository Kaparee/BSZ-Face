<Window x:Class="FaceAuthApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Bezpieczeństwa - NEURO SECURE" Height="700" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#15151D"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#3A86FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4C91FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#555566"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#2B2B36"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#444455" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3B3B46"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBlock Text="NEURO SECURE 2.0" Foreground="#3A86FF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Platforma Identyfikacyjna" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel x:Name="PanelMenu" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
            <TextBlock Text="Witaj w systemie. Wybierz akcję:" Foreground="#AAAAAA" FontSize="16" Margin="0,0,0,30" HorizontalAlignment="Center"/>
            <Button Content="🎥 Zaloguj się przez Kamerę" Style="{StaticResource PrimaryButton}" Width="280" Height="50" Margin="0,0,0,15" Click="ShowLoginPanel_Click"/>
            <Button Content="📝 Zarejestruj nową osobę" Style="{StaticResource SecondaryButton}" Width="280" Height="40" Click="ShowRegisterPanel_Click"/>
        </StackPanel>

        <StackPanel x:Name="PanelLogin" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,60,0,0">
            <TextBlock Text="Autoryzacja z Kamery" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <ComboBox x:Name="CameraDevicesBox" Width="300" Margin="0,0,0,10" Background="#2B2B36" Foreground="Black" Padding="5"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button x:Name="StartCameraBtn" Content="🎥 Włącz Kamerę" Style="{StaticResource SecondaryButton}" Width="145" Margin="0,0,5,0" Click="StartCameraBtn_Click"/>
                <Button x:Name="LoadDiskPhotoBtn" Content="📁 Wgraj z dysku" Style="{StaticResource SecondaryButton}" Width="145" Margin="5,0,0,0" Click="LoadDiskPhotoBtn_Click"/>
            </StackPanel>

            <Border Background="#1A1A24" CornerRadius="12" Margin="0,0,0,15" BorderBrush="#3A86FF" BorderThickness="2" ClipToBounds="True" Height="220" Width="300">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="0">
                        <TextBlock Text="🎥" FontSize="40" Foreground="#444455" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Kamera Wyłączona" Foreground="#666677" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Image x:Name="WebcamImage" Stretch="UniformToFill" Panel.ZIndex="1"/>
                </Grid>
            </Border>
            
            <Button x:Name="LoginScanBtn" Content="📸 Uchwyć twarz i autoryzuj" Style="{StaticResource PrimaryButton}" Height="45" Width="300" Click="LoginScan_Click" Margin="0,0,0,15" IsEnabled="False"/>
            
            <ProgressBar x:Name="LoginProgress" Height="4" Width="300" Margin="0,0,0,15" IsIndeterminate="True" Foreground="#3A86FF" Background="#2B2B36" Visibility="Collapsed"/>
            
            <TextBlock x:Name="LoginResultText" Text="System w gotowości. Włącz kamerę." Foreground="#AAAAAA" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Width="300"/>
            
            <Button Content="Powrót do menu" Style="{StaticResource SecondaryButton}" Width="150" Margin="0,30,0,0" Click="BackToMenu_Click"/>
        </StackPanel>

        <StackPanel x:Name="PanelRegister" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,60,0,0">
            <TextBlock Text="Rejestracja Profilu Biometrycznego" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Imię i Nazwisko:" Foreground="#AAAAAA" Margin="0,0,0,5" Width="300" HorizontalAlignment="Center"/>
            <TextBox x:Name="RegisterNameBox" Background="#2B2B36" Foreground="White" BorderBrush="#444455" BorderThickness="1" FontSize="16" Padding="5" Width="300" Margin="0,0,0,15"/>

            <ComboBox x:Name="RegisterCameraBox" Width="300" Margin="0,0,0,10" Background="#2B2B36" Foreground="Black" Padding="5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button x:Name="RegisterStartCamBtn" Content="🎥 Włącz Kamerę" Style="{StaticResource SecondaryButton}" Width="145" Margin="0,0,5,0" Click="RegisterStartCamera_Click"/>
                <Button x:Name="RegisterCaptureBtn" Content="📸 Uchwyć" Style="{StaticResource SecondaryButton}" Width="145" Margin="5,0,0,0" Click="RegisterCaptureBtn_Click" IsEnabled="False"/>
            </StackPanel>

            <Border Background="#2B2B36" CornerRadius="12" Margin="0,0,0,15" BorderBrush="#333340" BorderThickness="2" ClipToBounds="True" Height="180" Width="300">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="0">
                        <TextBlock Text="📷" FontSize="30" Foreground="#444455" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>
                    <Image x:Name="RegisterFaceImage" Stretch="Uniform" Panel.ZIndex="1"/>
                </Grid>
            </Border>
            
            <Button Content="📁 ...lub wgraj zdjęcie z dysku" Style="{StaticResource SecondaryButton}" Width="300" Height="35" Margin="0,0,0,15" Click="RegisterAddPhoto_Click"/>
            
            <Button x:Name="RegisterSubmitBtn" Content="Zapisz Profil" Style="{StaticResource PrimaryButton}" Height="45" Width="300" Click="RegisterSubmit_Click" Margin="0,0,0,10"/>
            <TextBlock x:Name="RegisterResultText" Text="" Foreground="#00E676" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,15"/>
            
            <Button Content="Anuluj" Style="{StaticResource SecondaryButton}" Width="150" Margin="0,10,0,0" Click="BackToMenu_Click"/>
        </StackPanel>
    </Grid>
</Window>
